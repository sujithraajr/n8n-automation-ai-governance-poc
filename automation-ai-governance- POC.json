    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"automation_fit_score\": 78,\n  \"summary\": \"A concise assessment of the opportunity.\",\n  \"recommended_pattern\": \"Form or event trigger -> validation -> rule-based logic -> AI assist -> human review -> system update\",\n  \"expected_benefits\": [\n    \"Reduce repetitive review\",\n    \"Improve consistency\"\n  ],\n  \"data_risk\": \"medium\",\n  \"ai_risk\": \"medium\",\n  \"operational_risk\": \"low\",\n  \"risk_reasons\": [\n    \"Contains personal data\",\n    \"AI supports a decision\"\n  ],\n  \"human_review_needed\": true,\n  \"assumptions\": [\n    \"Final eligibility decision remains with a human reviewer\"\n  ],\n  \"success_metrics\": [\n    \"Average handling time\",\n    \"Exception rate\",\n    \"Human override rate\"\n  ],\n  \"next_step\": \"Run a small proof of concept with synthetic or non-sensitive data and validate with the process owner.\"\n}"
      },
