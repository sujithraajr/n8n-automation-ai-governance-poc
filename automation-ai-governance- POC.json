    {
      "parameters": {
        "content": "## 1. Intake\nUse the public n8n Form for a real demo or the Manual Test branch for a sample run. The normalization step estimates annual effort and creates a consistent record.",
        "height": 220,
        "width": 430
      },
      "id": "62194b62-93fe-44ae-b133-4708e5342fd9",
      "name": "Note - Intake",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "content": "## 2. AI-assisted assessment\nThe AI Agent assesses automation fit, recommended pattern, risks, assumptions and success metrics. Structured Output Parser keeps the response machine-readable. AI output is advisory.",
        "height": 240,
        "width": 500
      },
      "id": "badb134b-d239-43af-bc65-743f4fbb1fba",
      "name": "Note - AI",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        784,
        0
      ]
    },
    {
      "parameters": {
        "content": "## 3. Governance guardrails\nDeterministic rules override the AI recommendation for sensitive/high-impact cases. This deliberately keeps final governance outside the model and routes the item to a human review level.",
        "height": 250,
        "width": 500
      },
      "id": "ab2e6bcd-0378-4656-abb9-570bef5606de",
      "name": "Note - Governance",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        1392,
        0
      ]
    },
    {
      "parameters": {
        "content": "## 4. Automation Registry\nThe workflow creates a structured registry record with owner, systems, AI use, preliminary risks, route, success metrics and next step. In a production version, connect this output to an n8n Data Table, Google Sheet, database, ServiceNow or GRC system.",
        "height": 230,
        "width": 420
      },
      "id": "a288c530-fafd-4445-ab4b-3ffaae8e6636",
      "name": "Note - Registry",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        2160,
        0
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combineBy": "combineByPosition",
        "options": {}
      },
      "id": "01835e67-566f-400d-b205-16f44c3eac80",
      "name": "Merge intake + AI assessment",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3.2,
      "position": [
        1088,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "// Deterministic governance guardrails: route_index 0 = human review, 1 = standard, 2 = low-risk fast track.\n// Deterministic rules deliberately override the AI recommendation.\nconst SENSITIVE_PATTERNS = /personal|gdpr|health|financial|payment|hr\b|employee|confidential|restricted|pii/i;\nconst HIGH_IMPACT_PATTERNS = /high|critical|regulatory|legal|customer-facing/i;\n\nreturn $input.all().map((item) => {\n  const j = item.json;\n  const a = j.output || {};\n  const fitScore = Number(a.automation_fit_score) || 0;\n  const sensitive = SENSITIVE_PATTERNS.test(j.data_sensitivity || '');\n  const highImpact = HIGH_IMPACT_PATTERNS.test(j.decision_impact || '') || a.human_review_needed === true;\n\n  let route_index, governance_route, governance_reasons = [];\n  if (sensitive || highImpact) {\n    route_index = 0;\n    governance_route = 'Human review required';\n    if (sensitive) governance_reasons.push('Data sensitivity requires Privacy/Compliance/InfoSec review.');\n    if (highImpact) governance_reasons.push('Decision impact or AI flag requires human validation.');\n  } else if (fitScore >= 7 && j.uses_ai === 'No') {\n    route_index = 2;\n    governance_route = 'Low-risk fast track';\n    governance_reasons.push('High automation fit, internal data, no AI component.');\n  } else {\n    route_index = 1;\n    governance_route = 'Standard review';\n    governance_reasons.push('Does not meet fast-track criteria; standard enablement review applies.');\n  }\n\n  return { json: { ...j, route_index, governance_route, governance_reasons } };\n});"
      },
      "id": "0184a94e-4244-445a-a808-890a81096d14",
      "name": "Deterministic governance guardrails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        384
      ]
    },
    {
      "parameters": {
        "mode": "expression",
        "numberOutputs": 3,
        "output": "={{ $json.route_index }}"
      },
      "id": "6bd33e01-3539-4268-997a-ac71df62ae23",
      "name": "Route by governance level",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        1536,
        368
      ]
    },
    {
      "parameters": {
        "assignments": {
