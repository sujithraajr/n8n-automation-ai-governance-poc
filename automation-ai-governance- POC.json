    {
      "parameters": {
        "jsCode": "const x = $json;\nconst a = x.output || x.assessment || {};\nconst registry_record = {\n  automation_id: x.intake_id,\n  created_at: x.submitted_at ?? new Date().toISOString(),\n  owner: x.requester_name,\n  team: x.team,\n  process_name: x.process_name,\n  systems: x.systems,\n  uses_ai: x.uses_ai,\n  automation_fit_score: a.automation_fit_score ?? null,\n  recommended_pattern: a.recommended_pattern ?? '',\n  preliminary_data_risk: a.data_risk ?? 'unknown',\n  preliminary_ai_risk: a.ai_risk ?? 'unknown',\n  preliminary_operational_risk: a.operational_risk ?? 'unknown',\n  governance_route: x.governance_route,\n  review_status: 'Pending human validation',\n  success_metrics: a.success_metrics ?? [],\n  next_step: a.next_step ?? '',\n  note: 'POC registry record. Final governance and compliance decisions remain with authorised reviewers.'\n};\nreturn [{\n  json: {\n    registry_record,\n    requester_name: registry_record.owner ?? '',\n    team: registry_record.team ?? '',\n    process_name: registry_record.process_name ?? '',\n    process_description: x.process_description ?? '',\n    frequency: x.frequency ?? '',\n    minutes_per_run: x.minutes_per_run ?? null,\n    systems: registry_record.systems ?? '',\n    data_sensitivity: x.data_sensitivity ?? '',\n    decision_impact: x.decision_impact ?? '',\n    uses_ai: registry_record.uses_ai ?? '',\n    desired_outcome: x.desired_outcome ?? '',\n    automation_fit_score: registry_record.automation_fit_score ?? null,\n    summary: a.summary ?? '',\n    recommended_pattern: registry_record.recommended_pattern ?? '',\n    expected_benefits: Array.isArray(a.expected_benefits) ? a.expected_benefits.join('; ') : (a.expected_benefits ?? ''),\n    data_risk: registry_record.preliminary_data_risk ?? 'unknown',\n    ai_risk: registry_record.preliminary_ai_risk ?? 'unknown',\n    operational_risk: registry_record.preliminary_operational_risk ?? 'unknown',\n    governance_route: registry_record.governance_route ?? '',\n    review_status: registry_record.review_status,\n    submitted_at: registry_record.created_at\n  }\n}];"
      },
      "id": "1f109a5c-d687-471b-8454-69bf2f3ed84a",
      "name": "Create automation registry record",
